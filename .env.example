# 视觉解读（图片 → 配乐）配置模板。
# 用法：cp .env.example .env，然后只在 .env 里填 key。
# .env 已在 .gitignore 里 —— 永远不要提交 .env / 真实 API Key。
# 已在 shell 里 export 的同名变量优先于 .env。

OPENAI_BASE_URL=https://code.ticoag.fun/v1
OPENAI_API_KEY=
# 默认 Qwen3.8-Flash-Next；逗号分隔可给多个，按顺序尝试，失败(404/403 无权限/5xx)再退到 DeepSeek-V4-Flash-Vision-Exp → gpt-4o-mini …
CTM_VISION_MODEL=Qwen3.8-Flash-Next

# 可选
# CTM_VISION_TIMEOUT=90
# CTM_VISION_MAX_TOKENS=4000
# CTM_VISION_REASONING=none   # reasoning_effort；none = 关闭思考（默认），off = 不发送该参数
# CTM_VISION_PROVIDER=openai
# ANTHROPIC_API_KEY=
